# Copy this file to .env and fill in real values. Never commit .env.
# Every setting is read with the ALPHADESK_ prefix.

# One of: dev, test, prod
ALPHADESK_ENVIRONMENT=dev

# Python logging level: DEBUG, INFO, WARNING, ERROR
ALPHADESK_LOG_LEVEL=INFO

# --- LLM provider (ADR 014) ---
# One of: openai, azure_openai
ALPHADESK_LLM_PROVIDER=openai
ALPHADESK_LLM_TIMEOUT_SECONDS=60
ALPHADESK_LLM_MAX_RETRIES=2

# OpenAI: required when ALPHADESK_LLM_PROVIDER=openai
ALPHADESK_OPENAI_API_KEY=
# Model name per tier. Both may point at the same model for now.
ALPHADESK_OPENAI_MODEL_SMALL=gpt-5-mini
ALPHADESK_OPENAI_MODEL_LARGE=gpt-5-mini

# Azure OpenAI: all required when ALPHADESK_LLM_PROVIDER=azure_openai, ignored otherwise
# Resource endpoint only; the code adds /openai/v1/
# ALPHADESK_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# ALPHADESK_AZURE_OPENAI_API_KEY=
# Deployment names you created in Azure, one per tier (may be the same)
# ALPHADESK_AZURE_OPENAI_DEPLOYMENT_SMALL=
# ALPHADESK_AZURE_OPENAI_DEPLOYMENT_LARGE=
