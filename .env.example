# Copy this file to .env and fill in real values. Never commit .env.
# Every setting is read with the ALPHADESK_ prefix.

# One of: dev, test, prod
ALPHADESK_ENVIRONMENT=dev

# Python logging level: DEBUG, INFO, WARNING, ERROR
ALPHADESK_LOG_LEVEL=INFO

# --- LLM provider (ADR 014) ---
# One of: openai, azure_openai
ALPHADESK_LLM_PROVIDER=openai
ALPHADESK_LLM_TIMEOUT_SECONDS=60
ALPHADESK_LLM_MAX_RETRIES=2
# Estimated tokens of conversation history sent on each model call. Older turns are left
# out of the call (they stay saved). Excludes the system prompt and tool schemas.
ALPHADESK_HISTORY_MAX_TOKENS=16000

# OpenAI: required when ALPHADESK_LLM_PROVIDER=openai
ALPHADESK_OPENAI_API_KEY=
# Model name per tier. Both may point at the same model for now.
ALPHADESK_OPENAI_MODEL_SMALL=gpt-5-mini
ALPHADESK_OPENAI_MODEL_LARGE=gpt-5-mini

# Azure OpenAI: all required when ALPHADESK_LLM_PROVIDER=azure_openai, ignored otherwise
# Resource endpoint only; the code adds /openai/v1/
# ALPHADESK_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# ALPHADESK_AZURE_OPENAI_API_KEY=
# Deployment names you created in Azure, one per tier (may be the same)
# ALPHADESK_AZURE_OPENAI_DEPLOYMENT_SMALL=
# ALPHADESK_AZURE_OPENAI_DEPLOYMENT_LARGE=

# --- Tracing: LangSmith (ADR 008) ---
# true sends a trace of every model and tool call to LangSmith. Unit tests always run with it off.
ALPHADESK_LANGSMITH_TRACING=false
# Required when ALPHADESK_LANGSMITH_TRACING=true
ALPHADESK_LANGSMITH_API_KEY=
ALPHADESK_LANGSMITH_PROJECT=alphadesk-dev
# Only outside LangSmith's US region, e.g. https://eu.api.smith.langchain.com
# ALPHADESK_LANGSMITH_ENDPOINT=

# --- Market data: Finnhub (ADR 007) ---
# Free key from finnhub.io. Needed by the get_quote tool.
ALPHADESK_FINNHUB_API_KEY=
ALPHADESK_FINNHUB_BASE_URL=https://finnhub.io/api/v1
ALPHADESK_FINNHUB_TIMEOUT_SECONDS=10

# --- Filings: SEC EDGAR ---
# No key needed, but SEC requires a User-Agent naming you, with a contact email.
# Needed by the get_financial_facts and list_recent_filings tools.
# Uncomment and put your own email in.
# ALPHADESK_SEC_EDGAR_USER_AGENT="AlphaDesk you@example.com"
ALPHADESK_SEC_EDGAR_TIMEOUT_SECONDS=10
# SEC allows at most 10 requests per second in total. Must be above 0 and at most 10.
ALPHADESK_SEC_EDGAR_MAX_REQUESTS_PER_SECOND=5

# --- Checkpointer: where conversation state is saved (ADR 005) ---
# One of: memory, postgres. memory forgets everything when the program exits.
# postgres keeps conversations across restarts. It needs `docker compose up -d` and
# `make setup-db` once.
ALPHADESK_CHECKPOINTER=postgres
# Required when ALPHADESK_CHECKPOINTER=postgres. Matches the local container in
# docker-compose.yml, which publishes Postgres on port 5433 (or POSTGRES_PORT, if set).
# For any other database, use its own URL and password.
ALPHADESK_POSTGRES_URL=postgresql://alphadesk:alphadesk@localhost:5433/alphadesk
# Seconds allowed to connect, and for any one statement. A whole number, at least 2.
ALPHADESK_POSTGRES_TIMEOUT_SECONDS=5
